{
  "manifest_version": 3,
  "name": "ReadLink AI – Let AI read your links",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "description": "Paste a Google Docs link in ChatGPT and ReadLink AI automatically loads the document content so the AI can read it.",

  "permissions": ["activeTab", "storage", "scripting"],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://docs.google.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "utils/textUtils.js",
        "utils/messaging.js",
        "linkDetector.js",
        "fetchers/googleDocs.js",
        "promptInterceptor.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  }
}